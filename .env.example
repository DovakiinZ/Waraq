# Copy to .env and fill in. Both values are public by design (they ship in the
# browser bundle and the APK); access is enforced by Postgres RLS, not by hiding them.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# NEVER put a service_role / sb_secret_ key in this file or anywhere under src/ —
# every VITE_* variable is compiled into the public JavaScript bundle.
# Server-side secrets (GEMINI_API_KEY, RESEND_API_KEY, ...) live in Supabase:
#   supabase secrets set NAME=value
